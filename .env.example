# Opcional: caminho do arquivo SQLite local. Sem override, usa o diretório de dados do usuário.
# SQLITE_PATH=/caminho/para/crm.sqlite

# Opcional: provedor de persistência. Valores aceitos: sqlite (padrão) e postgres.
# Valores desconhecidos impedem a inicialização em vez de cair no SQLite.
# O aplicativo desktop sempre usa sqlite.
# CRM_DB_DRIVER=sqlite

# Obrigatória quando CRM_DB_DRIVER=postgres. Aplique o schema antes de iniciar:
#   npm run db:migrate:postgres
# CRM_POSTGRES_URL=postgres://usuario:senha@localhost:5432/crm

# Opcional (fora do Electron): pasta dos logos. Sem override, usa ./tmp/assets.
# No aplicativo desktop o Electron define esta variável sozinho, junto do banco.
# CRM_ASSETS_DIR=/caminho/para/assets
